# AI provider: gemini (free tier, default) | ollama (local, free) | anthropic (paid)
BOM_AI_PROVIDER=gemini

# Free Gemini key from https://aistudio.google.com/apikey (no card needed)
GEMINI_API_KEY=

# Optional: comma-separated Gemini models to try in order
# BOM_GEMINI_MODEL=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
# BOM_GEMINI_TIMEOUT=90

# Ollama (fully offline): install from https://ollama.com, then `ollama pull qwen2.5vl:7b`
# BOM_OLLAMA_MODEL=qwen2.5vl:7b
# OLLAMA_URL=http://127.0.0.1:11434

# Anthropic (paid) only if BOM_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BOM_MODEL=claude-opus-5-5
# BOM_EFFORT=high

# BOM_TRIAL_CREDITS=25
# BOM_WORKERS=3

# Hosted access (leave BOM_PASSWORD empty for no login)
# BOM_USERNAME=team
# BOM_PASSWORD=
